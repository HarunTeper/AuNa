### COMMONLY CHANGED PARAMETERS ###

# Simulation scenario parameters
WORLD_NAME=racetrack_decorated # racetrack_decorated or arena
COMMUNICATION_TYPE=cam # cam or omnet

### DYNAMIC PARAMETERS ###

# User configuration
ROS_DOMAIN_ID=0
HOST_UID=1000
HOST_GID=1000

# Build parameters - NEW: ROS_DISTRO as configurable parameter
ROS_DISTRO=humble
RMW_IMPLEMENTATION=rmw_zenoh_cpp
PIP_BREAK_SYSTEM_PACKAGES=1

### STATIC PARAMETERS ###

# Simulation scenario parameters
MAP_NAME=${WORLD_NAME}

# Tracing Parameters
ROS_TRACE_DIR=/home/ubuntu/workspace/traces
LTTNG_HOME=/var/run/lttng

# Package names for services
# Space-separated list of ROS 2 packages under packages/src to build for each
# service. Note that auna_common is NOT listed here: it holds configuration,
# maps, worlds, waypoints and RViz layouts rather than a ROS 2 package, and is
# mounted into the containers as a read-only volume so that changing a
# parameter does not require a rebuild.
GAZEBO_PACKAGES=auna_gazebo auna_msgs
TF_PACKAGES=auna_tf
GROUND_TRUTH_PACKAGES=auna_ground_truth
EKF_PACKAGES=auna_ekf
PHYSICAL_CAR_PACKAGES=physical_car hardware_drivers
TELEOP_PACKAGES=auna_teleoperation
CONTROL_PANEL_PACKAGES=auna_control auna_msgs
COMM_PACKAGES=auna_comm
NAV2_PACKAGES=auna_nav2
CACC_PACKAGES=auna_cacc auna_msgs
WALLFOLLOWING_PACKAGES=auna_wallfollowing
WAYPOINT_PUBLISHER_PACKAGES=auna_waypoints

# Extra packages (system packages to install)
DEMO_PACKAGES=ros-${ROS_DISTRO}-demo-nodes-cpp
TF2_TOOLS_PACKAGES=ros-${ROS_DISTRO}-tf2-tools
RQT_PACKAGES=ros-${ROS_DISTRO}-rqt*
